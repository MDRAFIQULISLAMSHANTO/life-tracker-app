NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=1:your_sender_id:web:your_app_id
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Server-only. Firebase console > Project settings > Service accounts >
# Generate new private key, then base64 the downloaded JSON:
#   base64 -w0 service-account.json
# Used by the API routes to write shared content (daily quote, study library),
# which firestore.rules deny to every client. NEVER prefix this NEXT_PUBLIC_.
FIREBASE_SERVICE_ACCOUNT=your_base64_encoded_service_account_json
