rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Per-user synced payload docs: users/{uid}/liver/{finance|dashboardToday|growth}
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Shared content everyone reads live: the daily quote and the study library.
    // Writes are closed to every client — the Admin SDK in the API routes
    // bypasses these rules, so authorship is enforced there (verified ID token
    // checked against OWNER_EMAILS) rather than trusted from the browser.
    match /content/{document=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Legacy trackers — kept read/write for their OWNER only so the one-time
    // migration into the growth payload can still read them. Previously these
    // granted every signed-in user access to every other user's rows.
    match /trackers/{trackerId} {
      allow read, update, delete: if request.auth != null
                                  && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;
    }
    match /tracker_entries/{entryId} {
      allow read, update, delete: if request.auth != null
                                  && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;
    }
  }
}
